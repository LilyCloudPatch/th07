      ],
      "translated_lines": [
        "绝对有些不对劲"
      ]
    },
    "10/61_1": {
      "original_lines": [
        "何がでしょうか？"
      ],
      "translated_lines": [
        "是什么事呢？"
      ]
    },
    "10/102_0": {
      "original_lines": [
        "今宵の月の色の事かしら？",
        "それとも"
      ],
      "translated_lines": [
        "是说今宵的月色么？",
        "还是"
      ]
    },
    "10/104_0": {
      "original_lines": [
        "月の明度だ"
      ],
      "translated_lines": [
        "月光的亮度"
