  "resource": "data/msg8.dat",
  "entries": {
    "2/40_0": {
      "original_lines": [
        "また来たの？"
      ],
      "translated_lines": [
        "又来了吗？"
      ]
    },
    "2/120_0": {
      "original_lines": [
        "今日はもう疲れたし"
      ],
      "translated_lines": [
        "今天我已经累了"
      ]
    },
    "2/210_0": {
      "original_lines": [
        "そろそろ寝ようと思っていたのに"
      ],
      "translated_lines": [
        "差不多应该要去睡觉了呢"
      ]
    },
    "2/300_0": {
      "original_lines": [
        "約束通り、夜に来たわ"
      ],
      "translated_lines": [
        "按照约定，我晚上来了"
      ]
    },
    "0/60_0": {
      "original_lines": [
        "そろそろ、本命が出てきてもいい頃だわ"
      ],
      "translated_lines": [
        "差不多，该到最后的家伙出来的时刻了"
      ]
    },
    "0/61_0": {
      "original_lines": [
        "こんなにも闇が深いし"
      ],
      "translated_lines": [
        "夜已经如此之深了"
      ]
    },
    "0/61_1": {
      "original_lines": [
        "出てきましょうか？"
      ],
      "translated_lines": [
        "要我出来吗？"
      ]
    },
    "0/102_0": {
      "original_lines": [
        "ほら、出てきました"
      ],
      "translated_lines": [
        "看，现在出来了"
      ]
    },
    "0/103_0": {
      "original_lines": [
        "あ、丁度いいところに出てきた"
      ],
      "translated_lines": [
        "啊，出来的正好呢"
      ]
    },
    "0/104_h1_0": {
      "original_lines": [
        "　　　神隠しの主犯　　　　",
        "八雲　紫（やくも　ゆかり）"
      ],
      "translated_lines": [
        "神隐的主犯",
        " 八云　紫"
      ]
    },
    "0/104_0": {
      "original_lines": [
        "あなたが、私の藍を倒した人間ね"
      ],
      "translated_lines": [
        "你就是打倒了我的蓝的人类呢"
      ]
    },
    "0/105_0": {
      "original_lines": [
        "あなたみたいな物騒な人間が居たら"
      ],
      "translated_lines": [
        "就因为有你这样不老实的人类在"
      ]
    },
    "0/106_0": {
      "original_lines": [
        "おちおち寝ても居られないの"
      ],
      "translated_lines": [
        "让人连个安稳觉都睡不了"
      ]
    },
    "0/107_0": {
      "original_lines": [
        "全然、起きてこなかったじゃない"
      ],
      "translated_lines": [
        "你当时不是根本就没起来吗？"
      ]
    },
    "0/108_0": {
      "original_lines": [
        "今は起きているの"
      ],
      "translated_lines": [
        "现在起来了"
      ]
    },
    "0/109_0": {
      "original_lines": [
        "そんなことより、あなた・・・"
      ],
      "translated_lines": [
        "比起那些，你……"
      ]
    },
    "0/110_0": {
      "original_lines": [
        "はい？"
      ],
      "translated_lines": [
        "怎么？"
      ]
    },
    "0/111_0": {
      "original_lines": [
        "博麗神社のおめでたい人じゃないかしら"
      ],
      "translated_lines": [
        "就是博丽神社的那个冒傻气的人吧"
      ]
    },
    "0/112_0": {
      "original_lines": [
        "前半はそうで、後半はそうじゃない"
      ],
      "translated_lines": [
        "前半句正确，后半句错误"
      ]
    },
    "0/113_0": {
      "original_lines": [
        "博麗の結界は、北東側が薄くなっているわ"
      ],
      "translated_lines": [
        "博丽的结界，其东北侧正在变薄哦"
      ]
    },
    "0/114_0": {
      "original_lines": [
        "あのままだと、破れてしまうかも知れない"
      ],
      "translated_lines": [
        "这样下去的话，说不定会破呢"
      ]
    },
    "0/115_0": {
      "original_lines": [
        "あらそう、それは危険だわ",
        "わざわざ有難うございます"
      ],
      "translated_lines": [
        "啊呀是吗，那可真危险",
        "感谢你还特意告知"
      ]
    },
    "0/116_0": {
      "original_lines": [
        "いえいえ、私が穴を空けてみただけです"
      ],
      "translated_lines": [
        "哪里哪里，我只是试着开了个洞而已"
      ]
    },
    "0/117_0": {
      "original_lines": [
        "って、引き直しておきなさい！"
      ],
      "translated_lines": [
        "等等，给我立刻修复好！"
      ]
    },
    "0/118_0": {
      "original_lines": [
        "所詮、妖怪は妖怪"
      ],
      "translated_lines": [
        "妖怪终归是妖怪"
      ]
    },
    "0/119_0": {
      "original_lines": [
        "妖怪の始末も後始末も、人間がやる",
        "ことになるのね"
      ],
      "translated_lines": [
        "收拾妖怪和进行善后",
        "正是人类要做的"
      ]
    },
    "0/120_0": {
      "original_lines": [
        "あら、あなたは気がついていない？"
      ],
      "translated_lines": [
        "哎呀，你没注意到吗？"
      ]
    },
    "0/121_0": {
      "original_lines": [
        "？"
      ],
      "translated_lines": [
        "？"
      ]
    },
    "0/122_0": {
      "original_lines": [
        "今、ここ白玉楼の私の周りは"
      ],
      "translated_lines": [
        "现在，在这个白玉楼上我周围"
      ]
    },
    "0/123_0": {
      "original_lines": [
        "妖怪と人間の境界が薄くなって",
        "いることに"
      ],
      "translated_lines": [
        "妖怪和人类的境界",
        "变得稀薄了的事"
      ]
    },
    "0/124_0": {
      "original_lines": [
        "ここまで来た時点で、人間の境界を",
        "越していることに"
      ],
      "translated_lines": [
        "还有在来到这里的同时，也就跨过了",
        "人类的境界的事"
      ]
    },
    "0/125_0": {
      "original_lines": [
        "いいから、その境界も引き直して",
        "もらうわ"
      ],
      "translated_lines": [
        "好了，请把那个境界也给修补了吧"
      ]
    },
    "0/126_0": {
      "original_lines": [
        "元々、目的はあんたに冥界の境界を",
        "引きなおさせること"
      ],
      "translated_lines": [
        "本来我的目的就是要找你修复冥界的境界",
        "既然那样"
      ]
    },
    "0/127_0": {
      "original_lines": [
        "そこに来て、一つや二つ結界が",
        "増えても変らないでしょ？"
      ],
      "translated_lines": [
        "要修复的结界增加一两个",
        "不也没什么不同吗？"
      ]
    },
    "0/128_0": {
      "original_lines": [
        "一つや二つ・・・"
      ],
      "translated_lines": [
        "一两个…"
      ]
    },
    "0/129_0": {
      "original_lines": [
        "結界は、そんなに少ないと思って？"
      ],
      "translated_lines": [
        "你认为，结界会那么少吗？"
      ]
    },
    "1/60_0": {
      "original_lines": [
        "さーて、約束通り仕事して",
        "貰おうかしら"
      ],
      "translated_lines": [
        "那么，按照约定好的开始工作"
      ]
    },
    "1/61_0": {
      "original_lines": [
        "言われなくてもするつもりだったのに"
      ],
      "translated_lines": [
        "本来你不说我也准备去做的"
      ]
    },
    "1/62_0": {
      "original_lines": [
        "嘘ばっかり"
      ],
      "translated_lines": [
        "净说瞎话"
      ]
    },
    "1/63_0": {
      "original_lines": [
        "何時まで経っても、起きてこなかった",
        "じゃない"
      ],
      "translated_lines": [
        "你不是过了多久，都还不起来吗"
      ]
    },
    "1/64_0": {
      "original_lines": [
        "それは、寝ていたからだわ"
      ],
      "translated_lines": [
        "那是因为，睡着了的缘故啦"
      ]
    },
    "1/65_0": {
      "original_lines": [
        "それは当たり前"
      ],
      "translated_lines": [
        "不说也知道"
      ]
    },
    "1/66_0": {
      "original_lines": [
