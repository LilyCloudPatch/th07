    "10/109_0": {
      "original_lines": [
        "ただ、ここが雲の上だからじゃないかしら"
      ],
      "translated_lines": [
        "难道不是单因为这里是云顶之上吗"
      ]
    },
    "10/110_0": {
      "original_lines": [
        "で、誰だ？"
      ],
      "translated_lines": [
        "等等，你是谁？"
      ]
    },
    "10/111_h1_0": {
      "original_lines": [
        "　　　神隠しの主犯　　　　",
        "八雲　紫（やくも　ゆかり）"
      ],
      "translated_lines": [
        "神隐的主犯",
        " 八云　紫"
      ]
    },
    "10/111_0": {
      "original_lines": [
