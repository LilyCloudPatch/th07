      ],
      "translated_lines": [
        "发现我的结界是不可能的！"
      ]
    },
    "11/60_0": {
      "original_lines": [
        "お、夜も明けそうな時間だが"
      ],
      "translated_lines": [
        "哦，要到黎明的时间了"
      ]
    },
    "11/61_0": {
      "original_lines": [
