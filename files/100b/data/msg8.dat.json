      "translated_lines": [
        "你想得很周到"
      ]
    },
    "10/60_0": {
      "original_lines": [
        "おかしい"
      ],
      "translated_lines": [
        "不对劲"
      ]
    },
    "10/61_0": {
      "original_lines": [
