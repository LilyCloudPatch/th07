      "translated_lines": [
        "你好，我家蓝似乎给你添了麻烦"
      ]
    },
    "10/114_0": {
      "original_lines": [
        "私にというか、あの世の人にだが"
      ],
      "translated_lines": [
        "与其说给我添了麻烦，",
        "不如说给彼世的人添麻烦"
      ]
    },
    "10/115_0": {
      "original_lines": [
        "私がもっと"
      ],
      "translated_lines": [
        "我再试着"
      ]
    },
    "10/116_0": {
      "original_lines": [
        "暴れてみてもいいんですが"
      ],
      "translated_lines": [
        "闹腾一下似乎也不错呢"
      ]
    },
    "10/117_0": {
      "original_lines": [
        "迷惑の親分か"
      ],
      "translated_lines": [
        "麻烦的老大吗"
      ]
    },
    "10/118_0": {
      "original_lines": [
        "あなたは気がついていない"
      ],
      "translated_lines": [
        "你没有察觉到"
      ]
    },
    "10/119_0": {
      "original_lines": [
        "？"
      ],
      "translated_lines": [
        "？"
      ]
    },
    "10/120_0": {
      "original_lines": [
        "今宵は新月であったことに"
      ],
      "translated_lines": [
        "今宵是新月之夜的事"
      ]
    },
    "10/121_0": {
      "original_lines": [
        "すでに、昼と夜の境界は私の手の内に",
        "あることに"
      ],
      "translated_lines": [
        "还有就是白昼和黑夜的界线已经掌握",
        "在我手中了的事"
      ]
    },
    "10/122_0": {
      "original_lines": [
        "夕方の妖怪か？"
      ],
      "translated_lines": [
        "傍晚的妖怪吗？"
      ]
    },
    "10/123_0": {
      "original_lines": [
        "そんなもん手の内にあっても・・・"
      ],
      "translated_lines": [
        "那种东西就算掌握在手中也是…"
      ]
    },
    "10/124_0": {
      "original_lines": [
        "明け方？"
      ],
      "translated_lines": [
        "黎明的妖怪？"
      ]
    },
