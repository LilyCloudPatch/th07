{
  "schema": "lilypatch.text.v1",
  "target_id": "th07_100b",
  "resource": "data/end20b.end",
  "entries": {
    "8": {
      "original_lines": [
        "　　　　紅魔館にて"
      ],
      "translated_lines": [
        "　　　　红魔馆"
      ]
    },
    "11": {
      "original_lines": [
        "　　　　結局、西行妖は満開までは咲くことは無く、",
        "　　　　咲夜は、ひとまず着替えを取りに紅魔館に引き返すことにした"
      ],
      "translated_lines": [
        "　　　　结局，西行妖还是没有能盛开。",
        "　　　　咲夜决定暂且为了换衣服而返回红魔馆。"
      ]
    },
    "15": {
      "original_lines": [
        "　　　咲夜　「お変わりありませんか？お嬢様」"
      ],
      "translated_lines": [
        "　　　咲夜　「您没事吧？大小姐」"
      ]
    },
    "17": {
      "original_lines": [
        "　　レミリア「だーかーらー",
        "　　　　　　　お変わりなきゃダメでしょ？」"
      ],
      "translated_lines": [
        "　　蕾米莉亚「所～以～说～",
        "　　　　　　　没事怎么行呢？」"
      ]
    },
    "21": {
      "original_lines": [
        "　　　咲夜　「着替えを取りに着ただけですわ」"
      ],
      "translated_lines": [
        "　　　咲夜　「只是来换衣服的哟」"
      ]
    },
    "24": {
      "original_lines": [
        "　　　　ひとまず、雪と幽気にさらされた服を着替えると、",
        "　　　　再び出発の準備を行うのだった"
      ],
      "translated_lines": [
        "　　　　暂且，换好针对雪和幽气的防寒服后，",
        "　　　　咲夜进行着再次出发的准备。"
      ]
    },
    "27": {
      "original_lines": [
        "　　　　ＢＡＤ　ＥＮＤＩＮＧ　Ｎｏ．３",
        "　　　　ノーコンティニュークリアを目指そう！"
      ],
      "translated_lines": [
        "　　　　ＢＡＤ　ＥＮＤＩＮＧ　Ｎｏ．３",
        "　　　　以不续关通关为目标继续努力吧！"
      ]
    }
  }
}
