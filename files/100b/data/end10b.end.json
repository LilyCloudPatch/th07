{
  "schema": "lilypatch.text.v1",
  "target_id": "th07_100b",
  "resource": "data/end10b.end",
  "entries": {
    "8": {
      "original_lines": [
        "　　　　霧雨邸にて"
      ],
      "translated_lines": [
        "　　　　雾雨宅邸"
      ]
    },
    "11": {
      "original_lines": [
        "　　　　結局、西行妖は満開までは咲くことは無く、",
        "　　　　魔理沙は、寒いままの幻想郷に戻り、",
        "　　　　自宅で暖を取ることにした"
      ],
      "translated_lines": [
        "　　　　结果，西行妖还是没有能盛开。",
        "　　　　魔理沙回到了仍旧寒冷的幻想乡，",
        "　　　　在自己家取暖了。"
      ]
    },
    "16": {
      "original_lines": [
        "　　魔理沙　「結局なに？",
        "　　　　　　　自分の家が一番ってことか？」"
      ],
      "translated_lines": [
        "　　魔理沙　「结果么？",
        "　　　　　　　自己的家才是最好的？」"
      ]
    },
    "19": {
      "original_lines": [
        "　　魔理沙　「まぁ、いいぜ",
        "　　　　　　　死人になってからも桜に妄執するようじゃ、",
        "　　　　　　　哀れで見てられないぜ」"
      ],
      "translated_lines": [
        "　　魔理沙　「算了，不管了",
        "　　　　　　　已经死了还对樱花如此的执着，",
        "　　　　　　　真是太可怜了」"
      ]
    },
    "24": {
      "original_lines": [
        "　　　　短期間でも春を満喫してきた魔理沙は、",
        "　　　　再び春を味わいに出発することを決意したのであった"
      ],
      "translated_lines": [
        "　　　　短时间感受了春的魔理沙，",
        "　　　　决定了再次为体验春天而出发。"
      ]
    },
    "27": {
      "original_lines": [
        "　　　　ＢＡＤ　ＥＮＤＩＮＧ　Ｎｏ．２",
        "　　　　ノーコンティニュークリアを目指そう！"
      ],
      "translated_lines": [
        "　　　　ＢＡＤ　ＥＮＤＩＮＧ　Ｎｏ．２",
        "　　　　以不续关通关为目标继续努力吧！"
      ]
    }
  }
}
