    "12/300_0": {
      "original_lines": [
        "まだ、十日位だ"
      ],
      "translated_lines": [
        "才不过十天而已"
      ]
    },
    "10/60_0": {
      "original_lines": [
        "あー"
      ],
      "translated_lines": [
        "啊～"
      ]
    },
    "10/61_0": {
      "original_lines": [
        "本当に騒がしいな"
      ],
      "translated_lines": [
        "真的是很热闹呀"
      ]
    },
    "10/61_1": {
      "original_lines": [
        "今夜も、楽しい宴の準備～"
      ],
      "translated_lines": [
        "今晚也是快乐宴会的准备时间～"
      ]
    },
    "10/102_h1_0": {
      "original_lines": [
        "　　 すきま妖怪の式 　　",
        "八雲　藍（やくも　らん）"
      ],
      "translated_lines": [
        "隙间妖怪的式神",
        "　 八云　蓝"
      ]
    },
    "10/102_0": {
      "original_lines": [
        "おおう、人間発見"
      ],
      "translated_lines": [
        "哦哦，人类发现"
      ]
    },
    "10/103_0": {
      "original_lines": [
        "宴の準備が楽しいのか？",
        "変った奴だな"
      ],
      "translated_lines": [
        "宴会的准备很快乐么？",
        "奇怪的家伙呀"
      ]
    },
    "10/105_0": {
      "original_lines": [
        "何言ってるの",
        "「楽しい宴」の準備さ"
      ],
      "translated_lines": [
        "你在说什么呀。",
        "是「欢乐的宴会」的准备"
      ]
    },
    "10/107_0": {
      "original_lines": [
        "物事は準備が一番楽しい"
      ],
      "translated_lines": [
        "准备事情的时候是最快乐的"
      ]
    },
    "10/108_0": {
      "original_lines": [
        "いや、そういう奴も居るんでね"
      ],
      "translated_lines": [
        "哎呀，也有这种人呢"
      ]
    },
    "10/109_0": {
      "original_lines": [
        "ところで、この辺で猫を見かけ",
        "なかったか？"
      ],
      "translated_lines": [
        "那个，你有在这附近",
        "看到一只猫吗？"
      ]
    },
    "10/110_0": {
      "original_lines": [
        "準備はあいつの仕事なんだが"
      ],
      "translated_lines": [
        "准备本来应该是那家伙的工作的"
      ]
    },
    "10/111_0": {
      "original_lines": [
        "橙の事なら見かけなかったぜ"
      ],
      "translated_lines": [
        "如果说的是橙的话那我没看到"
      ]
    },
    "10/112_0": {
      "original_lines": [
        "やっぱりお前だな？",
        "橙を酷い目にあわせた奴は"
      ],
      "translated_lines": [
        "果然是你吗？",
        "那个欺负橙的家伙"
      ]
    },
    "10/113_0": {
      "original_lines": [
        "失礼な、酷い目に合わせたのではない"
      ],
      "translated_lines": [
        "失礼呀，我才没有欺负她。"
      ]
    },
    "10/114_0": {
      "original_lines": [
        "目も当てられない状態にしただけだぜ"
      ],
      "translated_lines": [
        "只是让她变成惨不忍睹的状态而已啦"
      ]
    },
    "10/115_0": {
      "original_lines": [
        "橙は私の式神"
      ],
      "translated_lines": [
        "橙是我的式神。"
      ]
    },
    "10/116_0": {
      "original_lines": [
        "式神ったって、安くは無い"
      ],
      "translated_lines": [
        "既然是式神，就没这么便宜"
      ]
    },
    "10/117_0": {
      "original_lines": [
        "式神が式神を使うのか"
      ],
      "translated_lines": [
        "式神也会使役式神呀，"
      ]
    },
    "10/118_0": {
      "original_lines": [
        "共喰いか？"
      ],
      "translated_lines": [
        "同类相残吗？"
      ]
    },
    "10/119_0": {
      "original_lines": [
        "誰が食べるなんて言ったのよ"
      ],
      "translated_lines": [
        "谁说过要吃什么了呀"
      ]
    },
    "10/120_0": {
      "original_lines": [
        "とりあえず、お前を使ってる奴が",
        "居るはずなんだよな"
      ],
      "translated_lines": [
        "总之，应该有个使役你的家伙",
        "在才对呀。"
      ]
    },
    "10/121_0": {
      "original_lines": [
        "それが橙とか"
      ],
      "translated_lines": [
        "那个叫橙什么的"
      ]
    },
    "10/122_0": {
      "original_lines": [
        "そんな訳無い"
      ],
      "translated_lines": [
        "不可能啦。"
      ]
    },
    "10/123_0": {
      "original_lines": [
        "ご主人様は、ぐっすりお休みですわ"
      ],
      "translated_lines": [
        "主人的话，现在睡得正香呢"
      ]
    },
    "10/124_0": {
      "original_lines": [
        "「式神を使える式神」を使う奴にも",
        "興味があるが"
      ],
      "translated_lines": [
        "「使役式神的式神」的使役者",
        "对此我有点兴趣呀"
      ]
    },
    "10/125_0": {
      "original_lines": [
        "呼び出して貰えないか？"
      ],
      "translated_lines": [
        "能麻烦叫她出来么？"
      ]
    },
    "10/126_0": {
      "original_lines": [
        "私は護衛でもあるわ"
      ],
      "translated_lines": [
        "护卫也是我的任务呀"
      ]
    },
    "10/127_0": {
      "original_lines": [
        "私の式神を目も当てられない状態にする",
        "人を、ご主人様に会わせる訳が無い"
      ],
      "translated_lines": [
        "没理由让一个把我的式神变成惨不忍睹",
        "的状态的人和主人见面的"
      ]
    },
