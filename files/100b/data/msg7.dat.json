      "translated_lines": [
        "这～个，冥界里有个麻烦的家伙，",
        "而且因为那家伙是某个人的使役魔……"
      ]
    },
    "1/80_0": {
      "original_lines": [
        "あ、目的はあんたを倒す事ね"
      ],
      "translated_lines": [
        "啊，我的目的就是打倒你呢"
      ]
    },
    "1/81_0": {
      "original_lines": [
        "しゅ～ん"
      ],
      "translated_lines": [
        "咻～～"
      ]
    },
    "12/40_0": {
      "original_lines": [
        "ここで遭ったが百年目"
      ],
      "translated_lines": [
        "在这里遇见可就是你的末日了"
      ]
    },
