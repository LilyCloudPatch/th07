  "entries": {
    "2/40_0": {
      "original_lines": [
        "ここで遭ったが百年目"
      ],
      "translated_lines": [
        "在这里遇见可就是你的末日了"
      ]
    },
    "2/120_0": {
      "original_lines": [
        "今日は憑きたての"
      ],
      "translated_lines": [
        "今天我可是有附体在"
      ]
    },
    "2/210_0": {
      "original_lines": [
        "ほやほやだよ！"
      ],
      "translated_lines": [
        "而且是刚刚完成的！"
      ]
    },
    "2/300_0": {
      "original_lines": [
        "どの辺がほやほや？"
      ],
      "translated_lines": [
        "怎样才算刚出炉？"
      ]
    },
    "0/60_0": {
      "original_lines": [
        "あの世くんだりまでやってきて"
      ],
      "translated_lines": [
        "好不容易来到偏远的冥界，"
      ]
    },
    "0/61_0": {
      "original_lines": [
        "目標が居なかったら退屈だわ"
      ],
      "translated_lines": [
        "结果要是没目标的话就无聊了"
      ]
    },
    "0/61_1": {
      "original_lines": [
        "おお？これは珍しい"
      ],
      "translated_lines": [
        "啊啊？这可真是少见呀"
      ]
    },
    "0/102_h1_0": {
      "original_lines": [
        "　　 すきま妖怪の式 　　",
        "八雲　藍（やくも　らん）"
      ],
      "translated_lines": [
        "隙间妖怪的式神",
        "　 八云　蓝"
      ]
    },
    "0/102_0": {
      "original_lines": [
        "こういう人間もこんな所にいるんだ"
      ],
      "translated_lines": [
        "原来在这里也会有这样的人呀"
      ]
    },
    "0/103_0": {
      "original_lines": [
        "こういうって何よ"
      ],
      "translated_lines": [
        "「这样」是什么意思呀?"
      ]
    },
    "0/104_0": {
      "original_lines": [
        "見てのとおり",
        "赤かったり白かったりで目出度い人間"
      ],
      "translated_lines": [
        "如你所见",
        "又红又白，吉利的冒傻气的人类"
      ]
    },
    "0/105_0": {
      "original_lines": [
        "猫の次は狐・・・",
        "何時からここは畜生界になったんでしょ"
      ],
      "translated_lines": [
        "刚才是猫现在又是狐狸...",
        "这里什么时候变成畜生界了"
      ]
    },
    "0/107_0": {
      "original_lines": [
        "あ、お前が橙に酷い目に遭わせた",
        "人間だな？"
      ],
      "translated_lines": [
        "啊，你就是把橙给欺负得很惨的",
        "人类吧？"
      ]
    },
    "0/108_0": {
      "original_lines": [
        "そうだっけ？"
      ],
      "translated_lines": [
        "是吗？"
      ]
    },
    "0/109_0": {
      "original_lines": [
        "橙は私の式神"
      ],
      "translated_lines": [
        "橙是我的式神。"
      ]
    },
    "0/110_0": {
      "original_lines": [
        "今は回復して、もっと強くなっているわ"
      ],
      "translated_lines": [
        "现在已经恢复，而且变得更强了"
      ]
    },
    "0/111_0": {
      "original_lines": [
        "・・・強かったっけ？"
      ],
      "translated_lines": [
        "……变强了吗？"
      ]
    },
    "0/112_0": {
      "original_lines": [
        "って、あんたの式神？",
        "あんたが式神じゃないの？"
      ],
      "translated_lines": [
        "等等、你的式神？",
        "你自己不是式神吗？"
      ]
    },
    "0/113_0": {
      "original_lines": [
        "私も式神"
      ],
      "translated_lines": [
        "我也是式神"
      ]
    },
    "0/114_0": {
      "original_lines": [
        "ご主人様はまだお休みですわ"
      ],
      "translated_lines": [
        "主人现在还在睡觉中"
      ]
    },
    "0/115_0": {
      "original_lines": [
        "やっぱり、あんたが目標ね"
      ],
      "translated_lines": [
        "果然，你就是目标喽"
      ]
    },
    "0/116_0": {
      "original_lines": [
        "何か用？"
      ],
      "translated_lines": [
        "有什么事吗？"
      ]
    },
    "0/117_0": {
      "original_lines": [
        "冥界と顕界の境を修復・・・",
        "って"
      ],
      "translated_lines": [
        "关于冥界和人界间境界的修复…"
      ]
    },
    "0/118_0": {
      "original_lines": [
        "よく考えたら"
      ],
      "translated_lines": [
        "等等，仔细想想，"
      ]
    },
    "0/119_0": {
      "original_lines": [
        "直接用があるのは、あんたの使い手",
        "のような気もしてきた"
      ],
      "translated_lines": [
        "我直接要找的人感觉好像应该是",
        "你的使役者的样子"
      ]
    },
    "0/120_0": {
      "original_lines": [
        "ご主人様は冬眠中ですが"
      ],
      "translated_lines": [
        "主人正在冬眠中"
      ]
    },
    "0/121_0": {
      "original_lines": [
        "起こして"
      ],
      "translated_lines": [
        "让她起来"
      ]
    },
    "0/122_0": {
      "original_lines": [
        "私は護衛でもあるわ"
      ],
      "translated_lines": [
        "护卫也是我的任务呀"
      ]
    },
    "0/123_0": {
      "original_lines": [
        "私の式神に酷い目を負わすような人を",
        "ご主人様に会わせる訳が無い"
      ],
      "translated_lines": [
        "没理由让一个欺负我的式神的人",
        "和主人见面啊"
      ]
    },
    "0/124_0": {
      "original_lines": [
        "ここは、今度は強くなった橙に",
        "やられるがいいわ"
      ],
      "translated_lines": [
        "这次就让你在这里",
        "被变强了的橙杀掉好了"
      ]
    },
    "0/125_0": {
      "original_lines": [
        "猫なら、さっき遭ったけど・・・"
      ],
      "translated_lines": [
        "猫的话，刚刚见到了……"
      ]
    },
    "0/126_0": {
      "original_lines": [
        "なんだって？",
        "それでどうなったのよ"
      ],
      "translated_lines": [
        "你说什么？",
        "那后来怎么样了？"
      ]
    },
    "0/127_0": {
      "original_lines": [
        "特に何も無かったかの様だったわ"
      ],
      "translated_lines": [
        "似乎也没什么特别的样子"
      ]
    },
    "0/128_0": {
      "original_lines": [
        "まぁ、橙は病み上がりだから"
      ],
      "translated_lines": [
        "算了，橙病刚好嘛"
      ]
    },
    "0/129_0": {
      "original_lines": [
        "さっきは、回復したっていってた癖に"
      ],
      "translated_lines": [
        "你刚刚不是才说过她恢复了的么"
      ]
    },
    "0/130_0": {
      "original_lines": [
        "ここは、私が橙の仇を取らなきゃいけない",
        "みたいね"
      ],
      "translated_lines": [
        "看来我不得不在这里给橙报",
        "一箭之仇呢"
      ]
    },
    "0/131_0": {
      "original_lines": [
        "さすがに、式神を倒せば"
      ],
      "translated_lines": [
        "如果打倒那家伙的式神"
      ]
    },
    "0/132_0": {
      "original_lines": [
        "使い手も冬眠から目覚めるかしら"
      ],
      "translated_lines": [
        "再怎样使役者也该从冬眠中醒来了"
      ]
    },
    "0/133_0": {
      "original_lines": [
        "ご主人様は、春眠も暁を覚えずよ"
      ],
      "translated_lines": [
        "我家主人可是春眠不觉晓哦"
      ]
    },
    "0/134_0": {
      "original_lines": [
        "まあ、取りあえずは",
        "目の前の障害から"
      ],
      "translated_lines": [
        "算了，不管怎样先从",
        "眼前的障碍开始！"
      ]
    },
    "0/135_0": {
      "original_lines": [
        "私は橙とは桁が違くてよ",
        "色々と"
      ],
      "translated_lines": [
        "我和橙可是差距悬殊的哦",
        "从很多方面来说"
      ]
    },
    "1/60_0": {
      "original_lines": [
        "式神風情が巫女に敵うと思って"
      ],
      "translated_lines": [
        "式神之流以为能敌得过巫女？"
      ]
    },
    "1/61_0": {
      "original_lines": [
        "私の式が通用しないなんて"
      ],
      "translated_lines": [
        "我的式法竟然会没有用。"
      ]
    },
    "1/62_0": {
      "original_lines": [
        "騙したわね～"
      ],
      "translated_lines": [
        "受骗了呀～"
      ]
    },
    "1/63_0": {
      "original_lines": [
        "なにを？"
      ],
      "translated_lines": [
        "什么意思？"
      ]
    },
    "1/64_0": {
      "original_lines": [
        "てっきり人間だと思っていたのに"
      ],
      "translated_lines": [
        "我本来完全以为你是人类的呀"
      ]
    },
    "1/65_0": {
      "original_lines": [
        "人間だってば"
      ],
      "translated_lines": [
        "本来就是人类啊。"
      ]
    },
    "1/66_0": {
      "original_lines": [
        "ともかく、折角だから",
        "あなたの主に会わせて貰おうかしら"
      ],
      "translated_lines": [
        "不管怎么样，好不容易才来",
        "就让我见见你的主人吧"
      ]
    },
    "1/67_0": {
      "original_lines": [
        "紫（ゆかり）様は、まだおやすみ中だわ"
      ],
      "translated_lines": [
        "紫大人还在睡觉中的……"
      ]
    },
    "1/68_0": {
      "original_lines": [
        "まだ、って何時になったら",
        "目が覚めるのよ"
      ],
      "translated_lines": [
        "还在，那究竟要到什么时",
        "候才会醒来呀。"
      ]
    },
    "1/69_0": {
      "original_lines": [
        "もう、十分に春じゃない"
      ],
      "translated_lines": [
        "现在不是已经很春了吗？"
      ]
    },
    "1/70_0": {
      "original_lines": [
        "紫様は冬も昼間も寝ているの",
        "こんな時間はまだ起きていない"
      ],
      "translated_lines": [
        "紫大人既要冬眠也要午睡",
        "现在这个时候还没起来"
      ]
    },
    "1/71_0": {
      "original_lines": [
        "もう夜の帳も落ちる頃の様な気がして",
        "ならないけど・・・"
      ],
      "translated_lines": [
        "总感觉差不多已经到",
        "夜幕降临的时候了……"
      ]
    },
    "1/72_0": {
      "original_lines": [
        "私達にとって、本当の宵闇はこんなもん",
        "じゃないの"
      ],
      "translated_lines": [
        "对于我们来说，真正的暗宵根本不是这种",
        "程度的东西"
      ]
    },
    "1/73_0": {
      "original_lines": [
        "人間が寝る時間が、本当の夜なのさ"
      ],
      "translated_lines": [
        "人类睡觉的时间，那才是真正的夜晚。"
      ]
    },
    "1/74_0": {
      "original_lines": [
        "いいから、起こしてよ"
      ],
      "translated_lines": [
        "好了啊，让她起来啦～"
      ]
    },
    "1/75_0": {
      "original_lines": [
        "といっても、紫様はここにはいないし～"
      ],
      "translated_lines": [
        "就算你这么说，紫大人本来也就不在这里～"
      ]
    },
    "1/76_0": {
      "original_lines": [
        "こいつはただの倒し損？"
      ],
      "translated_lines": [
        "你的意思是我白打了？"
      ]
    },
    "1/77_0": {
      "original_lines": [
        "ただのやられ損？"
      ],
      "translated_lines": [
        "我白被打倒了？"
      ]
    },
    "1/78_0": {
      "original_lines": [
        "って、あなたの目的は何？"
      ],
      "translated_lines": [
        "不对，你究竟有什么目的呀？"
      ]
    },
    "1/79_0": {
      "original_lines": [
        "えーと、冥界に迷惑な奴がいて、",
        "そいつが誰かの使い魔だから・・・"
